# CRITICAL: without this variable, the instrumentations emit the v1.36.0
# conventions or earlier. You would be reading the current docs while observing
# stale traces.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Content capture. Tool call arguments and results are opt_in in the spec:
# without explicit activation, you know that an action took place, not which
# one. That is exactly the typical audit finding.
# Valid values: NO_CONTENT, SPAN_ONLY, EVENT_ONLY, SPAN_AND_EVENT.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT

# Keys (depending on the provider under test)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
